<div class="agent-admin">
    <p>{read_only_notice}</p>

    <p><a href="{configuration_url}">{configuration_label}</a></p>

    <h2>{discovery_setup_label}</h2>
    <p>{discovery_setup_intro}</p>
    <pre><code>{discovery_rewrite_rule}</code></pre>
    <p>
        <a href="{discovery_test_url}" target="_blank" rel="noopener">{discovery_test_label}</a>
        &mdash;
        <a href="{discovery_direct_url}" target="_blank" rel="noopener">{discovery_direct_label}</a>
    </p>

    <h2>{runtime_label}</h2>
    <table class="admin-list" style="width:100%">
        <!-- BEGIN runtime_row -->
        <tr>
            <td>{runtime_name}</td>
            <td>{runtime_value}</td>
        </tr>
        <!-- END runtime_row -->
    </table>
</div>
